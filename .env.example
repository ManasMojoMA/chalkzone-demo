# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` — it is gitignored on purpose.

# ─────────────────────────────────────────────────────────────
# DATABASE (Supabase Postgres via Supavisor pooler)
# The app must use the TRANSACTION pooler (port 6543, IPv4).
# Migrations (prisma db push) use the SESSION pooler (port 5432).
# Both hostnames come from Supabase Dashboard → Connect.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# For local development with Docker instead (docker compose up -d):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_dev"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/erp_dev"

# ─────────────────────────────────────────────────────────────
# SUPABASE AUTH (Dashboard → Settings → API)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key — admin scripts only (create-supabase-users). Keep secret;
# do NOT set this on the deployed app.
SUPABASE_SERVICE_ROLE_KEY=""

# ─────────────────────────────────────────────────────────────
# GOOGLE GEMINI AI (AI assistant + knowledge-base embeddings)
# Get a key from https://aistudio.google.com/apikey
# Without a key the app runs in mock-AI mode — everything else works.
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=""
# Optional: pin a specific chat model (defaults to gemini-flash-latest)
# GEMINI_CHAT_MODEL="gemini-flash-latest"
